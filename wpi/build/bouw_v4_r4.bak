# ============================================================ Bijlage A
B[-1] = B[-1][:B[-1].rfind("<w:p ")]  # geen lege alinea na de laatste tabel
KOPPEN.append("Bijlage A. Vast te leggen gegevens per WPI")
add(_kn(para("Bijlage A. Vast te leggen gegevens per WPI", style="Kop1", size=24, space_after=80)).replace("<w:keepNext/>", "<w:keepNext/><w:pageBreakBefore/>", 1))
p("'(voorgesteld)' betekent: nog niet in het voorbeeldrapport (bijlage B); onderdeel van besluit 2. 'Verplicht' betekent "
  "dat Claude het rapport niet afrondt voordat het veld een waarde heeft. 'Bedient' noemt de VCA-eis (letters zoals in "
  "hoofdstuk 6) en de trends uit hoofdstuk 4 die het veld gebruiken. Er zijn geen velden over onderaannemers of derden. "
  "Tegenover het voorbeeldrapport vragen de voorgestelde velden van de inspecteur vier woorden in de kop (K8, K9, K10, "
  "K13), vier keer ja of nee (V1–V4) en bij elke afwijking twee korte antwoorden (R4, R5); dat is een verwachting, de "
  "proef meet de duur.")
VW = [2400, 2600, 1500, 1300, 1264]
for titel, groep in VELDEN.items():
    rows = [["Veld", "Waarom", "Verplicht", "Bedient", "Kost de inspecteur"]]
    for c, n, w, wr, vp, vca_, kost, vg in groep:
        naam = f"{c} {n}" + (V if vg else "") + (f"\n{w}" if w else "")
        bed = "; ".join(x for x in [vca_, ", ".join(TREND_VAN[c])] if x) or "–"
        rows.append([naam, wr, vp, bed, kost])
    add(_kn(para(titel, bold=True, size=20, space_after=40)))
    tbl(rows, VW, size=18)


